{
  "_doc": "Konfiguration für check.py. Jeder Eintrag in ignored_findings braucht eine nachvollziehbare note und sollte per PR reviewt werden.",
  "fail_level": "FAIL",
  "unreviewed_vulnerability_severity": "FAIL",
  "thresholds": {
    "stale_warn_days": 365,
    "stale_fail_days": 730,
    "no_release_warn_days": 365,
    "pluginsjson_max_age_days": 30,
    "future_version_tolerance_days": 31
  },
  "prerelease_tag_regex": "(?i)(rc\\d*$|-rc|beta|alpha|dev|test)",
  "allowed_duplicates": {
    "auth_oidc": "Upstream aus dem Verzeichnis und eLeDia-Fork werden beide ausgeliefert; pluginCheck.sh wählt zur Laufzeit (eledia_oidc)."
  },
  "ignored_findings_doc": "Befunde, die bewertet sind und bewusst ignoriert werden (werden INFO, bleiben im Bericht). Je Eintrag: component (oder * für übergreifende Befunde), check, optional match (Textausschnitt der Meldung, z. B. die CVE-ID), reason (risk_accepted | mitigated | false_positive | fixed) und note mit nachvollziehbarer Begründung. Bei fixed zusätzlich fixed_version: gilt nur, solange die ausgelieferte Version mindestens so hoch ist.",
  "ignored_findings": [
    {
      "component": "auth_oidc",
      "check": "vulnerability",
      "match": "CVE-2026-54733",
      "reason": "false_positive",
      "note": "Betrifft local_o365 (Teams-SSO-Endpunkt), nicht auth_oidc. local_o365 wird nicht ausgeliefert (geprüft 2026-10-07) – neu bewerten, falls es hinzukommt."
    }
  ],
  "cve_min_term_length": 5,
